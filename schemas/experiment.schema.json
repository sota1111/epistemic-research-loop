{
  "$defs": {
    "CandidateDescriptors": {
      "additionalProperties": false,
      "description": "Behavior descriptor used by the solution and epistemic QD archives.",
      "properties": {
        "data_scope": {
          "default": "train_only",
          "minLength": 1,
          "title": "Data Scope",
          "type": "string"
        },
        "entity_hypothesis": {
          "default": "none",
          "minLength": 1,
          "title": "Entity Hypothesis",
          "type": "string"
        },
        "epistemic_niche": {
          "default": "unassigned",
          "minLength": 1,
          "title": "Epistemic Niche",
          "type": "string"
        },
        "error_profile": {
          "default": "global",
          "minLength": 1,
          "title": "Error Profile",
          "type": "string"
        },
        "model_family": {
          "default": "other",
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "post_processing": {
          "default": "none",
          "minLength": 1,
          "title": "Post Processing",
          "type": "string"
        },
        "representation": {
          "default": "raw",
          "minLength": 1,
          "title": "Representation",
          "type": "string"
        },
        "routing": {
          "default": "none",
          "minLength": 1,
          "title": "Routing",
          "type": "string"
        },
        "shift_hypothesis": {
          "default": "none",
          "minLength": 1,
          "title": "Shift Hypothesis",
          "type": "string"
        },
        "source_agent": {
          "default": "unknown",
          "minLength": 1,
          "title": "Source Agent",
          "type": "string"
        },
        "validation_type": {
          "default": "random",
          "minLength": 1,
          "title": "Validation Type",
          "type": "string"
        },
        "validation_world": {
          "default": "unspecified",
          "minLength": 1,
          "title": "Validation World",
          "type": "string"
        }
      },
      "title": "CandidateDescriptors",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "properties": {
        "cpu_hours": {
          "default": 0,
          "minimum": 0,
          "title": "Cpu Hours",
          "type": "number"
        },
        "failure_probability": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Failure Probability",
          "type": "number"
        },
        "gpu_hours": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Hours",
          "type": "number"
        },
        "llm_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Tokens",
          "type": "integer"
        },
        "monetary_cost": {
          "default": 0,
          "minimum": 0,
          "title": "Monetary Cost",
          "type": "number"
        },
        "wall_hours": {
          "default": 0,
          "minimum": 0,
          "title": "Wall Hours",
          "type": "number"
        }
      },
      "title": "CostEstimate",
      "type": "object"
    },
    "DecisionBinding": {
      "additionalProperties": false,
      "properties": {
        "action_changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Changed"
        },
        "action_neutral_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Neutral Reason"
        },
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "possible_actions": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Possible Actions",
          "type": "array"
        },
        "result_to_action": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Result To Action",
          "type": "object"
        }
      },
      "required": [
        "decision_id",
        "possible_actions",
        "result_to_action"
      ],
      "title": "DecisionBinding",
      "type": "object"
    },
    "DecisionOutcome": {
      "enum": [
        "informative_action_changing",
        "informative_action_neutral",
        "inconclusive",
        "invalid"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "increase",
        "decrease",
        "unchanged",
        "pattern"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EVSIProxy": {
      "additionalProperties": false,
      "description": "Auditable value-of-sample-information approximation.\n\nThe proxy is deliberately factored into the probability that a downstream\ndecision changes and the utility difference between the competing actions.\nAn agent cannot provide a final EVSI number independently of these inputs.",
      "properties": {
        "decision_change_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Decision Change Probability",
          "type": "number"
        },
        "decision_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Decision Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "utility_difference": {
          "maximum": 1,
          "minimum": 0,
          "title": "Utility Difference",
          "type": "number"
        }
      },
      "required": [
        "decision_change_probability",
        "utility_difference",
        "decision_ids",
        "rationale"
      ],
      "title": "EVSIProxy",
      "type": "object"
    },
    "EpistemicAssessment": {
      "additionalProperties": false,
      "properties": {
        "decision_consequence": {
          "maximum": 4,
          "minimum": 0,
          "title": "Decision Consequence",
          "type": "integer"
        },
        "hypothesis_discrimination": {
          "maximum": 4,
          "minimum": 0,
          "title": "Hypothesis Discrimination",
          "type": "integer"
        },
        "outcome_observability": {
          "maximum": 4,
          "minimum": 0,
          "title": "Outcome Observability",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "search_space_reduction": {
          "maximum": 4,
          "minimum": 0,
          "title": "Search Space Reduction",
          "type": "integer"
        },
        "uncertainty_reduction": {
          "maximum": 4,
          "minimum": 0,
          "title": "Uncertainty Reduction",
          "type": "integer"
        }
      },
      "required": [
        "hypothesis_discrimination",
        "uncertainty_reduction",
        "decision_consequence",
        "search_space_reduction",
        "outcome_observability",
        "rationale"
      ],
      "title": "EpistemicAssessment",
      "type": "object"
    },
    "EpistemicNiche": {
      "enum": [
        "temporal",
        "entity_client",
        "validation",
        "distribution_shift",
        "label_quality",
        "feature_representation",
        "model_family",
        "error_analysis",
        "falsification",
        "post_processing",
        "ensemble"
      ],
      "title": "EpistemicNiche",
      "type": "string"
    },
    "ExperimentKind": {
      "enum": [
        "diagnostic",
        "candidate_producing"
      ],
      "title": "ExperimentKind",
      "type": "string"
    },
    "ExperimentStatus": {
      "enum": [
        "proposed",
        "gated",
        "selected",
        "rejected",
        "running",
        "completed",
        "failed"
      ],
      "title": "ExperimentStatus",
      "type": "string"
    },
    "ExperimentType": {
      "enum": [
        "exploit",
        "solution_explore",
        "epistemic",
        "diagnostic",
        "optimization",
        "falsification",
        "robustness",
        "ensemble",
        "replication",
        "ablation"
      ],
      "title": "ExperimentType",
      "type": "string"
    },
    "HoldoutAccess": {
      "enum": [
        "none",
        "working_validation",
        "sealed_holdout"
      ],
      "title": "HoldoutAccess",
      "type": "string"
    },
    "HypothesisOutcomeForecast": {
      "additionalProperties": false,
      "description": "Likelihood model used to calculate information gain without an LLM self-score.\n\nThe hypothesis may still be proposed by a model, but the two likelihood vectors are fixed before\nexecution. Selection combines them with the hypothesis probability from the event log.",
      "properties": {
        "decisions_affected": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Decisions Affected",
          "type": "array"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "measurement_notes": {
          "minLength": 1,
          "title": "Measurement Notes",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/OutcomeLikelihood"
          },
          "minItems": 2,
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "outcomes",
        "decisions_affected",
        "measurement_notes"
      ],
      "title": "HypothesisOutcomeForecast",
      "type": "object"
    },
    "OutcomeLikelihood": {
      "additionalProperties": false,
      "description": "A preregistered observable outcome under a binary research hypothesis.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "probability_if_false": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability If False",
          "type": "number"
        },
        "probability_if_true": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability If True",
          "type": "number"
        }
      },
      "required": [
        "label",
        "probability_if_true",
        "probability_if_false"
      ],
      "title": "OutcomeLikelihood",
      "type": "object"
    },
    "PredictedOutcome": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "coverage_level": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Level"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "discriminates_from": {
          "items": {
            "type": "string"
          },
          "title": "Discriminates From",
          "type": "array"
        },
        "expected_direction": {
          "$ref": "#/$defs/Direction"
        },
        "expected_range": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Range"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        }
      },
      "required": [
        "description",
        "metric_name",
        "expected_direction",
        "condition"
      ],
      "title": "PredictedOutcome",
      "type": "object"
    },
    "ReplicationSpec": {
      "additionalProperties": false,
      "properties": {
        "changed_condition": {
          "items": {
            "enum": [
              "seed",
              "time_window",
              "entity_slice"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Changed Condition",
          "type": "array"
        },
        "original_experiment_id": {
          "minLength": 1,
          "title": "Original Experiment Id",
          "type": "string"
        },
        "replication_hypothesis": {
          "minLength": 1,
          "title": "Replication Hypothesis",
          "type": "string"
        }
      },
      "required": [
        "original_experiment_id",
        "changed_condition",
        "replication_hypothesis"
      ],
      "title": "ReplicationSpec",
      "type": "object"
    },
    "ResourceEstimate": {
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "default": 1,
          "minimum": 1,
          "title": "Cpu Cores",
          "type": "integer"
        },
        "expected_minutes": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Expected Minutes",
          "type": "number"
        },
        "full_table_materialization": {
          "default": false,
          "title": "Full Table Materialization",
          "type": "boolean"
        },
        "gpu_memory_gb": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Memory Gb",
          "type": "number"
        },
        "heavy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heavy"
        },
        "memory_gb": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Memory Gb",
          "type": "number"
        },
        "parquet_scan_columns": {
          "default": 0,
          "minimum": 0,
          "title": "Parquet Scan Columns",
          "type": "integer"
        }
      },
      "title": "ResourceEstimate",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk",
      "type": "string"
    },
    "RobustnessAssessment": {
      "additionalProperties": false,
      "properties": {
        "fold_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Fold Coverage",
          "type": "number"
        },
        "leakage_checks": {
          "maximum": 1,
          "minimum": 0,
          "title": "Leakage Checks",
          "type": "number"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "seed_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Seed Coverage",
          "type": "number"
        },
        "subgroup_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Subgroup Coverage",
          "type": "number"
        },
        "temporal_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Temporal Coverage",
          "type": "number"
        }
      },
      "required": [
        "seed_coverage",
        "fold_coverage",
        "subgroup_coverage",
        "temporal_coverage",
        "leakage_checks",
        "rationale"
      ],
      "title": "RobustnessAssessment",
      "type": "object"
    },
    "ScoreEstimate": {
      "additionalProperties": false,
      "properties": {
        "fold_std": {
          "default": 0,
          "minimum": 0,
          "title": "Fold Std",
          "type": "number"
        },
        "mean_gain": {
          "default": 0,
          "description": "Expected improvement on the primary metric. Positive is always better. If the metric is minimised, report the expected reduction as a positive number.",
          "title": "Mean Gain",
          "type": "number"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "seed_std": {
          "default": 0,
          "minimum": 0,
          "title": "Seed Std",
          "type": "number"
        },
        "uncertainty": {
          "default": 0,
          "minimum": 0,
          "title": "Uncertainty",
          "type": "number"
        },
        "worst_group_gap": {
          "default": 0,
          "minimum": 0,
          "title": "Worst Group Gap",
          "type": "number"
        }
      },
      "title": "ScoreEstimate",
      "type": "object"
    },
    "SemanticExperimentSignature": {
      "additionalProperties": false,
      "description": "Meaning-level identity used instead of command or experiment ID.",
      "properties": {
        "candidate_producing": {
          "default": false,
          "title": "Candidate Producing",
          "type": "boolean"
        },
        "data_slice": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Slice",
          "type": "array"
        },
        "decision_affected": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Decision Affected",
          "type": "array"
        },
        "observable": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observable",
          "type": "array"
        },
        "operation": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Operation",
          "type": "array"
        },
        "target_hypotheses": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "target_hypotheses",
        "data_slice",
        "operation",
        "observable",
        "decision_affected"
      ],
      "title": "SemanticExperimentSignature",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "competition_specific": {
          "default": false,
          "title": "Competition Specific",
          "type": "boolean"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "policy_reason": {
          "title": "Policy Reason",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "paper",
            "official_docs",
            "competition_page",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "title",
        "source_type",
        "allowed",
        "policy_reason",
        "content_hash"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "ValidationOutcomeLikelihood": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "probability_by_world": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 2,
          "title": "Probability By World",
          "type": "object"
        }
      },
      "required": [
        "label",
        "probability_by_world"
      ],
      "title": "ValidationOutcomeLikelihood",
      "type": "object"
    },
    "ValidationWorldForecast": {
      "additionalProperties": false,
      "description": "Preregistered categorical result distribution under each validation world.",
      "properties": {
        "decisions_affected": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Decisions Affected",
          "type": "array"
        },
        "measurement_notes": {
          "minLength": 1,
          "title": "Measurement Notes",
          "type": "string"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/ValidationOutcomeLikelihood"
          },
          "minItems": 2,
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "outcomes",
        "metric_name",
        "decisions_affected",
        "measurement_notes"
      ],
      "title": "ValidationWorldForecast",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_exception_reason": {
      "anyOf": [
        {
          "enum": [
            "validation_leakage_unresolved",
            "dataset_corruption_unresolved",
            "required_observation_missing",
            "insufficient_resources"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Exception Reason"
    },
    "candidate_producing": {
      "default": false,
      "title": "Candidate Producing",
      "type": "boolean"
    },
    "contamination_risk": {
      "$ref": "#/$defs/Risk",
      "default": "low"
    },
    "controls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    },
    "decision_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decision_rule": {
      "minLength": 1,
      "title": "Decision Rule",
      "type": "string"
    },
    "descriptors": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateDescriptors"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "discrimination_value": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Discrimination Value",
      "type": "number"
    },
    "discrimination_values_by_prior": {
      "items": {
        "type": "number"
      },
      "title": "Discrimination Values By Prior",
      "type": "array"
    },
    "epistemic_assessment": {
      "$ref": "#/$defs/EpistemicAssessment"
    },
    "epistemic_niche": {
      "anyOf": [
        {
          "$ref": "#/$defs/EpistemicNiche"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "estimated_cost": {
      "$ref": "#/$defs/CostEstimate"
    },
    "evsi_proxy": {
      "anyOf": [
        {
          "$ref": "#/$defs/EVSIProxy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_score_gain": {
      "$ref": "#/$defs/ScoreEstimate"
    },
    "experiment_kind": {
      "$ref": "#/$defs/ExperimentKind",
      "default": "diagnostic"
    },
    "experiment_type": {
      "$ref": "#/$defs/ExperimentType"
    },
    "falsification_proposal_id": {
      "anyOf": [
        {
