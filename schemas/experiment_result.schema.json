{
  "$defs": {
    "FailureClass": {
      "enum": [
        "infrastructure",
        "implementation",
        "model",
        "invalid_design"
      ],
      "title": "FailureClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "dataset_fingerprint": {
      "title": "Dataset Fingerprint",
      "type": "string"
    },
    "environment_hash": {
      "title": "Environment Hash",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Runtime",
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "run_id",
    "attempt",
    "status",
    "commit_sha",
    "environment_hash",
    "dataset_fingerprint"
  ],
  "title": "ExperimentResult",
  "type": "object"
}
