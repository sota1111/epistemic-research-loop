{
  "$defs": {
    "FailureClass": {
      "enum": [
        "infrastructure",
        "implementation",
        "model",
        "invalid_design"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "ObservedResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "cpu_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Hours"
        },
        "gpu_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Hours"
        },
        "llm_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Tokens"
        },
        "monetary_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monetary Cost"
        },
        "peak_ram_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Ram Gb"
        },
        "wall_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Hours"
        }
      },
      "title": "ObservedResourceUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "dataset_fingerprint": {
      "title": "Dataset Fingerprint",
      "type": "string"
    },
    "environment_hash": {
      "title": "Environment Hash",
      "type": "string"
    },
    "environment_lock_hash": {
      "default": "unavailable",
      "title": "Environment Lock Hash",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_excerpt": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the run failed, in the words of whatever failed. A failure class alone tells the next proposal that a design did not run; it does not tell it what to change.",
      "title": "Failure Excerpt"
    },
    "manifest_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Ref"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "observed_outcomes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Observed Outcomes",
      "type": "object"
    },
    "resource_usage": {
      "$ref": "#/$defs/ObservedResourceUsage"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Runtime",
      "type": "object"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "run_id",
    "attempt",
    "status",
    "commit_sha",
    "environment_hash",
    "dataset_fingerprint"
  ],
  "title": "ExperimentResult",
  "type": "object"
}
