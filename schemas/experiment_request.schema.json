{
  "$defs": {
    "DatasetMount": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "DatasetMount",
      "type": "object"
    },
    "EpistemicNiche": {
      "enum": [
        "temporal",
        "entity_client",
        "validation",
        "distribution_shift",
        "label_quality",
        "feature_representation",
        "model_family",
        "error_analysis",
        "falsification",
        "post_processing",
        "ensemble"
      ],
      "title": "EpistemicNiche",
      "type": "string"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "default": 1,
          "minimum": 1,
          "title": "Cpu",
          "type": "integer"
        },
        "expected_minutes": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Expected Minutes",
          "type": "number"
        },
        "full_table_materialization": {
          "default": false,
          "title": "Full Table Materialization",
          "type": "boolean"
        },
        "gpu": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu",
          "type": "integer"
        },
        "gpu_memory_gb": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Memory Gb",
          "type": "number"
        },
        "memory_gb": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Memory Gb",
          "type": "number"
        },
        "parquet_scan_columns": {
          "default": 0,
          "minimum": 0,
          "title": "Parquet Scan Columns",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "ResourceRequest",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "system_a",
        "system_b",
        "system_b_plus",
        "system_c",
        "epistemic",
        "exploiter_only"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "SemanticExperimentSignature": {
      "additionalProperties": false,
      "description": "Meaning-level identity used instead of command or experiment ID.",
      "properties": {
        "candidate_producing": {
          "default": false,
          "title": "Candidate Producing",
          "type": "boolean"
        },
        "data_slice": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Data Slice",
          "type": "array"
        },
        "decision_affected": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Decision Affected",
          "type": "array"
        },
        "observable": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observable",
          "type": "array"
        },
        "operation": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Operation",
          "type": "array"
        },
        "target_hypotheses": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "target_hypotheses",
        "data_slice",
        "operation",
        "observable",
        "decision_affected"
      ],
      "title": "SemanticExperimentSignature",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit_sha": {
      "minLength": 1,
      "title": "Base Commit Sha",
      "type": "string"
    },
    "brief": {
      "additionalProperties": true,
      "title": "Brief",
      "type": "object"
    },
    "candidate_producing": {
      "default": false,
      "title": "Candidate Producing",
      "type": "boolean"
    },
    "command": {
      "default": "",
      "title": "Command",
      "type": "string"
    },
    "config_hash": {
      "default": "unavailable",
      "title": "Config Hash",
      "type": "string"
    },
    "container_image": {
      "minLength": 1,
      "title": "Container Image",
      "type": "string"
    },
    "dataset_fingerprint": {
      "default": "unavailable",
      "title": "Dataset Fingerprint",
      "type": "string"
    },
    "dataset_mounts": {
      "items": {
        "$ref": "#/$defs/DatasetMount"
      },
      "title": "Dataset Mounts",
      "type": "array"
    },
    "epistemic_niche": {
      "anyOf": [
        {
          "$ref": "#/$defs/EpistemicNiche"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "implementation_mode": {
      "minLength": 1,
      "title": "Implementation Mode",
      "type": "string"
    },
    "network_policy": {
      "default": "disabled",
      "enum": [
        "disabled",
        "source_policy_proxy",
        "enabled"
      ],
      "title": "Network Policy",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "required_outputs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Outputs",
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/ResourceRequest"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "semantic_signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticExperimentSignature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system_mode": {
      "$ref": "#/$defs/RunMode",
      "default": "epistemic"
    }
  },
  "required": [
    "request_id",
    "experiment_id",
    "run_id",
    "idempotency_key",
    "base_commit_sha",
    "implementation_mode",
    "objective",
    "container_image",
    "dataset_mounts",
    "resources",
    "seeds",
    "required_outputs"
  ],
  "title": "ExperimentRequest",
  "type": "object"
}
