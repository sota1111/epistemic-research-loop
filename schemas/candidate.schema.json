{
  "$defs": {
    "CandidateDescriptors": {
      "additionalProperties": false,
      "description": "Behavior descriptor used by the solution and epistemic QD archives.",
      "properties": {
        "data_scope": {
          "default": "train_only",
          "minLength": 1,
          "title": "Data Scope",
          "type": "string"
        },
        "entity_hypothesis": {
          "default": "none",
          "minLength": 1,
          "title": "Entity Hypothesis",
          "type": "string"
        },
        "epistemic_niche": {
          "default": "unassigned",
          "minLength": 1,
          "title": "Epistemic Niche",
          "type": "string"
        },
        "error_profile": {
          "default": "global",
          "minLength": 1,
          "title": "Error Profile",
          "type": "string"
        },
        "model_family": {
          "default": "other",
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "post_processing": {
          "default": "none",
          "minLength": 1,
          "title": "Post Processing",
          "type": "string"
        },
        "representation": {
          "default": "raw",
          "minLength": 1,
          "title": "Representation",
          "type": "string"
        },
        "routing": {
          "default": "none",
          "minLength": 1,
          "title": "Routing",
          "type": "string"
        },
        "shift_hypothesis": {
          "default": "none",
          "minLength": 1,
          "title": "Shift Hypothesis",
          "type": "string"
        },
        "source_agent": {
          "default": "unknown",
          "minLength": 1,
          "title": "Source Agent",
          "type": "string"
        },
        "validation_type": {
          "default": "random",
          "minLength": 1,
          "title": "Validation Type",
          "type": "string"
        },
        "validation_world": {
          "default": "unspecified",
          "minLength": 1,
          "title": "Validation World",
          "type": "string"
        }
      },
      "title": "CandidateDescriptors",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "descriptors": {
      "$ref": "#/$defs/CandidateDescriptors"
    },
    "error_diversity": {
      "default": 0,
      "minimum": 0,
      "title": "Error Diversity",
      "type": "number"
    },
    "expected_hidden_score": {
      "title": "Expected Hidden Score",
      "type": "number"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "fold_assignment_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fold Assignment Artifact"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "leakage_check_passed": {
      "default": false,
      "title": "Leakage Check Passed",
      "type": "boolean"
    },
    "leakage_risk": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Leakage Risk",
      "type": "number"
    },
    "normalized_cost": {
      "default": 0,
      "minimum": 0,
      "title": "Normalized Cost",
      "type": "number"
    },
    "oof_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oof Artifact"
    },
    "reproduction_passed": {
      "default": false,
      "title": "Reproduction Passed",
      "type": "boolean"
    },
    "robustness": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Robustness",
      "type": "number"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "score_variance": {
      "default": 0,
      "minimum": 0,
      "title": "Score Variance",
      "type": "number"
    },
    "submission_procedure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Procedure"
    }
  },
  "required": [
    "id",
    "run_id",
    "experiment_id",
    "descriptors",
    "expected_hidden_score"
  ],
  "title": "QDCandidate",
  "type": "object"
}
