{
  "$defs": {
    "EventType": {
      "enum": [
        "RunCreated",
        "WorldModelRecorded",
        "ValidationWorldRegistered",
        "ValidationEvidenceRecorded",
        "ValidationPosteriorUpdated",
        "ObservationRecorded",
        "HypothesisProposed",
        "HypothesisRevised",
        "ExperimentProposed",
        "ExperimentSelected",
        "ExperimentStarted",
        "ExperimentCompleted",
        "ExperimentFailed",
        "ExperimentRetryScheduled",
        "ResourceReconciled",
        "AgentResourceRecorded",
        "FalsificationRecorded",
        "FalsificationProposed",
        "BeliefUpdated",
        "ForecastCalibrationRecorded",
        "PhaseChanged",
        "StateChanged",
        "ResearchBriefCreated",
        "FinalSelectionRuleRegistered",
        "QDCandidateEvaluated",
        "OOFArtifactRecorded",
        "OOFAnalysisRecorded",
        "OOFEnsembleCreated",
        "SubmissionSealed",
        "LeaderboardFeedbackRecorded",
        "HoldoutUnsealed",
        "RunFinalized",
        "ViolationDetected"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_hash": {
      "title": "Event Hash",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Hash"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "run_id",
    "event_type",
    "payload",
    "event_hash"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
