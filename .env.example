# Runtime API access (never commit real values)
LINEAR_API_KEY=
# Kaggle CLI 2.x authenticates with an access token (KGAT...) issued from your
# Kaggle account settings; the legacy KAGGLE_KEY / kaggle.json pair is no longer accepted.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Evaluator-owned; research agents must not receive this value.
BENCHMARK_UNSEAL_TOKEN=

# Optional CLI workspace root.
ERL_HOME=.
